{
  "schema_version": "scout.crawl-snapshot-reconciliation-demo.v1",
  "description": "Logical fixtures for dynamic Crawl event and validated snapshot reconciliation. Labels are not ingestible Scout IDs.",
  "cases": [
    {
      "key": "event_first",
      "arrival_order": ["complete_event_export", "complete_snapshot_batch"],
      "publication_binding": "exact",
      "accepted_capture_events": 3,
      "manifest_captured_page_count": 3,
      "expected": ["awaiting_validated_snapshot_batch", "authoritative"]
    },
    {
      "key": "snapshot_first",
      "arrival_order": ["complete_snapshot_batch", "complete_event_export"],
      "publication_binding": "exact",
      "accepted_capture_events": 2,
      "manifest_captured_page_count": 2,
      "expected": ["awaiting_publication_event", "authoritative"]
    },
    {
      "key": "failed_export_then_exact_replay",
      "arrival_order": ["failed_event_batch", "complete_exact_replay", "complete_snapshot_batch"],
      "identity_ledger_original_batch": "failed_event_batch",
      "expected": ["provisional_no_validated_snapshot", "authoritative"]
    },
    {
      "key": "publication_without_snapshot_batch",
      "arrival_order": ["complete_publication_event"],
      "publication_binding": "exact-checksums-but-no-ingested-snapshot",
      "expected": "awaiting_validated_snapshot_batch"
    },
    {
      "key": "publication_checksum_mismatch",
      "arrival_order": ["complete_snapshot_batch", "complete_publication_event"],
      "publication_binding": "wrong-source-snapshot-sha256",
      "expected": "publication_binding_mismatch"
    },
    {
      "key": "capture_events_late",
      "arrival_order": ["snapshot", "publication", "two-of-three-captures", "last-capture"],
      "accepted_capture_events": [2, 3],
      "manifest_captured_page_count": 3,
      "expected": ["awaiting_capture_events", "authoritative"]
    },
    {
      "key": "incomplete_crawl",
      "arrival_order": ["complete-event-export"],
      "crawl_status": "incomplete",
      "snapshot_batch": null,
      "expected": "provisional_no_validated_snapshot"
    },
    {
      "key": "canonical-admission-and-alias",
      "capture_matches": [
        {"task_id": 41, "source_id": "source-a", "requested_url": "https://example.test/a", "body_sha256": "body-a", "capture_id": "capture-a", "admission_status": "admitted", "page_id": "page-a"},
        {"task_id": 42, "source_id": "source-a", "requested_url": "https://example.test/alias", "body_sha256": "body-a", "capture_id": "capture-alias", "admission_status": "exact-alias", "alias_page_id": "alias-a", "representative_page_id": "page-a"},
        {"task_id": 43, "source_id": "source-a", "requested_url": "https://example.test/a", "body_sha256": "body-old", "capture_id": "capture-old", "admission_status": "superseded-capture", "selected_capture_id": "capture-a"}
      ],
      "expected": ["authoritative_admitted", "authoritative_alias", "authoritative_superseded"],
      "logical_page_count": 1,
      "logical_alias_count": 1
    },
    {
      "key": "ambiguous-body-only-match",
      "capture_event": {"task_id": 55, "source_id": "source-a", "body_sha256": "shared"},
      "manifest_candidates": ["capture-x", "capture-y"],
      "operational_task_match": null,
      "expected": "provisional_unmatched"
    },
    {
      "key": "duplicate-export-replay",
      "arrival_order": ["event-batch-v1", "snapshot-batch-v1", "event-batch-v2", "snapshot-batch-v2"],
      "same_event_ids": true,
      "same_snapshot_and_checksums": true,
      "expected": "one logical Page and alias observation per canonical history key"
    }
  ]
}
