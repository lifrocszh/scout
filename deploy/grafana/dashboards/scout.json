        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pages fetched",
      "description": "Successful page fetches by all workers in the selected time range. Uses max_over_time, so workers that already exited still count.",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          },
          "expr": "sum(max_over_time(scout_pages_fetched_total{outcome=\"success\"}[$__range]))",
          "legendFormat": "fetched",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
