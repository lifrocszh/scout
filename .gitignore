/target/
/.scratch/
/data/*
!/data/configs/
/data/configs/*
!/data/configs/*.toml
!/data/configs/archive/
/data/configs/archive/*
!/data/configs/archive/*.toml

# Local runtime artifacts
*.log
*.sqlite
*.sqlite3
*.db

# Local configuration and editor/OS files
.env
.env.*
!.env.example
.DS_Store
*.swp

# Python caches
__pycache__/
*.py[cod]

# Run artifacts are local evidence; keep the human-readable reports and configs
# versionable without accidentally adding large generated datasets.
/docs/runs/**
!/docs/runs/**/
!/docs/runs/**/*.md
!/docs/runs/**/*.toml
