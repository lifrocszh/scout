/target/
/.scratch/
/data/*
!/data/configs/
/data/configs/*
!/data/configs/*.toml
!/data/configs/archive/
/data/configs/archive/*
!/data/configs/archive/*.toml

# Local runtime artifacts
*.log
*.sqlite
*.sqlite3
*.db
/onnxruntime_profile__*.json

# Local configuration and editor/OS files
.env
.env.*
!.env.example
.DS_Store
*.swp

# Python caches
__pycache__/
*.py[cod]

# Keep raw run evidence local. Commit concise reports under docs/runs/reports/.
/docs/runs/*
!/docs/runs/reports/
/docs/runs/reports/*
!/docs/runs/reports/*.md
/docs/portfolio-roadmap.md
