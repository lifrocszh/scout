# Copy to .env (git-ignored); Compose reads it automatically:  cp .env.example .env
# Everything the stack needs is configured here or in compose.yaml. No secret
# is baked into the image.

# Required. Password for the Compose-internal Postgres; the database is not
# published on the host. It is embedded in a postgresql:// URL, so use only
# URL-safe characters (letters, digits, - . _ ~). Change it from this example.
POSTGRES_PASSWORD=change-me-before-sharing

# Optional. Defaults shown.
#SCOUT_IMAGE=scout:local                        # or ghcr.io/lifrocszh/scout:latest to use the published image
#SCOUT_HTTP_PORT=8080                           # search API port on 127.0.0.1
#SCOUT_INDEX_MODE=keyword-only                  # keyword-only | hybrid | semantic-only (downloads the model on first use)
#SCOUT_SOURCES_CONFIG_FILE=./docker/sources.fixture.toml
#SCOUT_CRAWL_RUN_ID=run-<64 lowercase hex>      # change it to run a fresh crawl on an existing volume

# Observability (docker compose --profile obs up). Defaults shown.
#GRAFANA_PORT=3000                              # Grafana on 127.0.0.1 (anonymous viewer; admin login below)
#GRAFANA_ADMIN_PASSWORD=admin                   # change it if the host is shared
#PROMETHEUS_PORT=9090                           # Prometheus on 127.0.0.1
#SCOUT_METRICS_LINGER_SECS=0                    # keep the coordinator and workers serving /metrics this long after the crawl (try 10)
#SCOUT_METRICS_SAMPLE_SECS=2                    # how often the coordinator samples frontier depth from Postgres
